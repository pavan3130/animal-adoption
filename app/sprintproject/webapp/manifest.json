{
  "_version": "1.89.0",
  "sap.app": {
    "id": "animaladoption.admin.sprintproject",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "099bb2da-f0a0-4a47-8e91-ff86b23e92d5"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "Admin-display": {
          "semanticObject": "Admin",
          "action": "display",
          "title": "{{Admin-display.flpTitle}}",
          "subTitle": "{{Admin-display.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "animaladoption.admin.sprintproject.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "animaladoption.admin.sprintproject.ext.controller.AdminExtension"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "animaladoption.admin.sprintproject.ext.controller.AdminExtension"
          }
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "AnimalsList",
          "target": "AnimalsList"
        },
        {
          "pattern": "Animals({key}):?query:",
          "name": "AnimalsObjectPage",
          "target": "AnimalsObjectPage"
        }
      ],
      "targets": {
        "AnimalsList": {
          "type": "Component",
          "id": "AnimalsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Animals",
              "variantManagement": "Page",
              "navigation": {
                "Animals": {
                  "detail": {
                    "route": "AnimalsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "homeAction": {
                      "text": "Home",
                      "icon": "sap-icon://home",
                      "press": "animaladoption.admin.sprintproject.ext.controller.AdminExtension.onHome"
                    },
                    "signOutAction": {
                      "text": "Sign Out",
                      "icon": "sap-icon://log",
                      "press": "animaladoption.admin.sprintproject.ext.controller.AdminExtension.onSignOut"
                    }
                  }
                }
              }
            }
          }
        },
        "AnimalsObjectPage": {
          "type": "Component",
          "id": "AnimalsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Animals",
              "content": {
                "header": {
                  "actions": {
                    "homeAction": {
                      "text": "Home",
                      "icon": "sap-icon://home",
                      "press": "animaladoption.admin.sprintproject.ext.controller.AdminExtension.onHome"
                    },
                    "signOutAction": {
                      "text": "Sign Out",
                      "icon": "sap-icon://log",
                      "press": "animaladoption.admin.sprintproject.ext.controller.AdminExtension.onSignOut"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
