{
  "_version": "1.89.0",
  "sap.app": {
    "id": "animaladoption.inspection.inspectionmanagement",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "e3061b43-79aa-4e71-a45d-d4fd50f25184"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/inspector/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "InspectionManagement-display": {
          "semanticObject": "InspectionManagement",
          "action": "display",
          "title": "{{InspectionManagement-display.flpTitle}}",
          "subTitle": "{{InspectionManagement-display.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "animaladoption.inspection.inspectionmanagement.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "animaladoption.inspection.inspectionmanagement.ext.controller.InspectionExtension"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "animaladoption.inspection.inspectionmanagement.ext.controller.InspectionExtension"
          }
        }
      }
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "InspectionsList",
          "target": "InspectionsList"
        },
        {
          "pattern": "Inspections({key}):?query:",
          "name": "InspectionsObjectPage",
          "target": "InspectionsObjectPage"
        }
      ],
      "targets": {
        "InspectionsList": {
          "type": "Component",
          "id": "InspectionsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/Inspections",
              "variantManagement": "Page",
              "navigation": {
                "Inspections": {
                  "detail": {
                    "route": "InspectionsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              },
              "content": {
                "header": {
                  "actions": {
                    "homeAction": {
                      "text": "Home",
                      "icon": "sap-icon://home",
                      "press": "animaladoption.inspection.inspectionmanagement.ext.controller.InspectionExtension.onHome"
                    },
                    "signOutAction": {
                      "text": "Sign Out",
                      "icon": "sap-icon://log",
                      "press": "animaladoption.inspection.inspectionmanagement.ext.controller.InspectionExtension.onSignOut"
                    }
                  }
                }
              }
            }
          }
        },
        "InspectionsObjectPage": {
          "type": "Component",
          "id": "InspectionsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/Inspections",
              "content": {
                "header": {
                  "actions": {
                    "homeAction": {
                      "text": "Home",
                      "icon": "sap-icon://home",
                      "press": "animaladoption.inspection.inspectionmanagement.ext.controller.InspectionExtension.onHome"
                    },
                    "signOutAction": {
                      "text": "Sign Out",
                      "icon": "sap-icon://log",
                      "press": "animaladoption.inspection.inspectionmanagement.ext.controller.InspectionExtension.onSignOut"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}